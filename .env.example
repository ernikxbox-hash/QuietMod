# ── Quiet Mod 👁️ — переменные окружения ─────────────────────────────
# Скопируй в Railway Variables (или в .env для локального запуска).
# Обязательные помечены [нужно], остальные — опциональны.

# [нужно] Токен от @BotFather
BOT_TOKEN=

# [нужно] Твой Telegram ID (узнать: @userinfobot)
ADMIN_ID=

# [нужно] Ключ от https://console.groq.com — ИИ и расшифровка голосовых
GROQ_API_KEY=

# Запасной ключ Groq — бот переключится при лимите/ошибке первого
GROQ_API_KEY2=

# Аварийный ключ Groq — на случай исчерпания лимитов 1 и 2
GROQ_API_KEY3=

# (необязательно) Прямая ссылка на PNG-рамку для .ramka с прозрачным
# отверстием (например, raw-файл на GitHub). Пусто → рамка рисуется кодом.
RAMKA_URL=

# 🛡 Гейт подписки: юзернейм канала БЕЗ @. Пустая строка = гейт выключен.
CHANNEL_USERNAME=Official_QuietMod

# Ссылка, на которую ведёт кнопка «🔔 Подписаться на канал»
CHANNEL_URL=https://t.me/Official_QuietMod

# (необязательно) Числовой ID канала гейта (-100…). Не ставить — бот сам
# зафиксирует ID, как только его добавят в канал с CHANNEL_USERNAME.
CHANNEL_ID=

# ── MTProto-слой (опция): резолв ЛЮБЫХ публичных юзеров по @username
# для .sled/.info (Bot API это не умеет). Берутся на my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# (необязательно, рекомендуется) StringSession владельца от Telethon —
# полный резолв публичных юзеров. Строка секретная, храни только в Variables.
TELEGRAM_USER_SESSION=
